{
  "framework": null,
  "installCommand": "echo Flutter dependencies are installed during build",
  "buildCommand": "tar -xzf sakan-source.tar.gz && bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/customer/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/customer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/customer/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ]
}
